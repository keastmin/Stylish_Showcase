    "synonyms": [],
    "m_Precision": 1,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "JetSoftVolume",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 sampleUV;\nsampleUV.x = UVBias.x + UVScale.x * (0.5 + 0.5 * sin(6.28318530718 * UV.x));\nsampleUV.y = UV.y * UVScale.y + UVBias.y;\nfloat luminance = SAMPLE_TEXTURE2D(Mask.tex, Mask.samplerstate, sampleUV).r;\nfloat facing = abs(dot(normalize(Normal), normalize(View)));\nfloat softVolume = pow(saturate(facing), 1.5);\nfloat ends = smoothstep(0.0, 0.045, UV.y) * (1.0 - smoothstep(0.72, 1.0, UV.y));\nfloat4 cellDistance = (UV.y - float4(0.28, 0.505, 0.71, 0.89)) / float4(0.035, 0.033, 0.029, 0.025);\nfloat4 cellDensity = exp(-0.5 * cellDistance * cellDistance);\nfloat pressureDensity = max(max(cellDensity.x, cellDensity.y), max(cellDensity.z, cellDensity.w));\nfloat axialSoftness = lerp(1.0, pressureDensity, saturate(ShockMode));\nColor = Tint * luminance;\nAlpha = Opacity * softVolume * ends * axialSoftness;"
}
